#!/usr/bin/env bash
set -euo pipefail

uid_num="$(id -u)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${uid_num}}"
export PULSE_SERVER="${PULSE_SERVER:-unix:${XDG_RUNTIME_DIR}/pulse/native}"

card="${FT710_AUDIO_CARD:-FT710}"
device="${FT710_AUDIO_DEVICE:-0}"
out_name="${FT710_AUDIO_TX_SINK:-ft710_out_44100}"
in_name="${FT710_AUDIO_RX_SOURCE:-ft710_in_44100}"
out_volume="${FT710_TX_VOL:-100%}"
in_volume="${FT710_RX_VOL:-100%}"
set_defaults="${FT710_AUDIO_SET_DEFAULTS:-true}"

for command in pactl aplay; do
  command -v "${command}" >/dev/null || {
    printf 'Required command not found: %s\n' "${command}" >&2
    exit 1
  }
done

if ! pactl info >/dev/null 2>&1; then
  printf 'The PipeWire/PulseAudio compatibility server is not available at %s\n' "${PULSE_SERVER}" >&2
  exit 1
fi

if ! aplay -l 2>/dev/null | grep -q "${card}"; then
  printf 'ALSA card %s was not found. Check the FT-710 USB connection and udev rule.\n' "${card}" >&2
  exit 1
fi

printf 'Removing old FreeRig710 audio modules, if present...\n'
while read -r module_id _; do
  [[ -n "${module_id}" ]] && pactl unload-module "${module_id}" >/dev/null 2>&1 || true
done < <(pactl list short modules | awk -v out="${out_name}" -v inn="${in_name}" '$0 ~ out || $0 ~ inn {print $1, $0}')

printf 'Creating the %s stereo sink at 44.1 kHz...\n' "${out_name}"
pactl load-module module-alsa-sink \
  device="hw:CARD=${card},DEV=${device}" \
  sink_name="${out_name}" \
  rate=44100 \
  channels=2 \
  format=s16le \
  sink_properties="device.description=FT710_OUT_44100" >/dev/null

printf 'Creating the %s mono source at 44.1 kHz...\n' "${in_name}"
pactl load-module module-alsa-source \
  device="hw:CARD=${card},DEV=${device}" \
  source_name="${in_name}" \
  rate=44100 \
  channels=1 \
  format=s16le \
  source_properties="device.description=FT710_IN_44100" >/dev/null

if [[ "${set_defaults,,}" =~ ^(1|true|yes|on)$ ]]; then
  pactl set-default-sink "${out_name}"
  pactl set-default-source "${in_name}"
fi

pactl set-sink-volume "${out_name}" "${out_volume}"
pactl set-source-volume "${in_name}" "${in_volume}"

printf '\nFreeRig710 audio endpoints are ready:\n'
pactl list short sinks | grep -F "${out_name}" || true
pactl list short sources | grep -F "${in_name}" || true
