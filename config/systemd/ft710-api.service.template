[Unit]
Description=FreeRig710 radio control, audio, video and FT8 API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@INSTALL_DIR@/api
EnvironmentFile=/etc/ft710-api.env
Environment=HOME=@HOME@
Environment=PYTHONUNBUFFERED=1
ExecStart=@INSTALL_DIR@/api/run-api.sh
Restart=always
RestartSec=3
TimeoutStopSec=15
SupplementaryGroups=video dialout audio plugdev

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
UMask=0077

[Install]
WantedBy=multi-user.target
