[Unit]
Description=Load the FreeRig710 EDID into the TC358743 HDMI-to-CSI2 bridge
After=systemd-udev-trigger.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'for i in $(seq 1 30); do /usr/bin/v4l2-ctl -d @VIDEO_DEVICE@ --set-edid=pad=0,file=@EDID_FILE@ && exit 0; sleep 1; done; exit 1'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
