# Copy this file to /etc/ft710-api.env and replace every example value.
# This file deliberately contains no passwords, tokens, cookie keys or TLS keys.

# Installation and network
FREERIG710_INSTALL_DIR=/opt/freerig710
FT710_ROOT_PATH=/ft710-api
FT710_API_HOST=192.0.2.10
FT710_API_PORT=8100
FT710_UVICORN_LOG_LEVEL=info
FT710_FORWARDED_ALLOW_IPS=192.0.2.20,127.0.0.1

# CAT-2 / Standard COM: reserved exclusively for the FastAPI service
FT710_CAT2_DEVICE=/dev/ttyFT710_AUX
FT710_CAT2_BAUD=115200
FT710_CAT2_QUERY_TIMEOUT=0.75
FT710_CAT2_WRITE_TIMEOUT=0.5
FT710_POLL_INTERVAL=0.75
FT710_SETTINGS_POLL_INTERVAL=0.5
FT710_ALLOW_RAW_CAT=false

# Runtime database. The file is created automatically and must not be committed.
FT710_MEMORIES_DB=/opt/freerig710/api/data/memories.sqlite3
FT710_MEMORY_QUERY_TIMEOUT=0.30

# Tuning control
FT710_JOG_TICK_INTERVAL=0.20
FT710_JOG_MIN_SPEED_HZ_S=10
FT710_JOG_MAX_SPEED_HZ_S=100000

# HDMI-to-CSI2 video
FT710_VIDEO_ENABLED=true
FT710_VIDEO_DEVICE=/dev/video0
FT710_VIDEO_WIDTH=800
FT710_VIDEO_HEIGHT=480
FT710_VIDEO_INPUT_FPS=60
FT710_VIDEO_OUTPUT_FPS=8
FT710_VIDEO_JPEG_QUALITY=55
FT710_VIDEO_CLIENT_MAX_MBPS=3.0
FT710_GST_LAUNCH_BINARY=/usr/bin/gst-launch-1.0

# Browser and WSJT-X audio. Replace 1000 with the UID of FT710_FT8_USER.
FT710_AUDIO_ENABLED=true
FT710_AUDIO_RX_SOURCE=ft710_in_44100
FT710_AUDIO_TX_SINK=ft710_out_44100
FT710_AUDIO_FRAME_MS=20
FT710_AUDIO_RX_PACKET_MS=40
FT710_AUDIO_RX_QUEUE_MS=1000
FT710_AUDIO_TX_PACKET_MS=20
FT710_AUDIO_LATENCY_MS=100
FT710_AUDIO_TX_MAX_QUEUE_MS=240
FT710_AUDIO_PTT_TAIL_MS=80
FT710_AUDIO_PTT_TAIL_TIMEOUT_MS=350
FT710_AUDIO_TX_IDLE_SILENCE=true
FT710_AUDIO_PULSE_SERVER=unix:/run/user/1000/pulse/native
FT710_AUDIO_XDG_RUNTIME_DIR=/run/user/1000
FT710_AUDIO_ALLOWED_ORIGIN=https://radio.example.com
FT710_PAREC_BINARY=/usr/bin/parec
FT710_PAPLAY_BINARY=/usr/bin/paplay
FT710_PTT_WATCHDOG_SECONDS=1.5

# FT8 desktop: TigerVNC on localhost, websockify/noVNC on the private LAN.
FT710_FT8_ENABLED=true
FT710_TIGERVNCSERVER_BINARY=/usr/bin/tigervncserver
FT710_WEBSOCKIFY_BINARY=/usr/bin/websockify
FT710_NOVNC_WEB_ROOT=/usr/share/novnc
FT710_FT8_DISPLAY=:105
FT710_FT8_GEOMETRY=1280x800
FT710_FT8_DEPTH=24
FT710_FT8_VNC_HOST=127.0.0.1
FT710_FT8_VNC_PORT=6005
FT710_FT8_BIND_HOST=192.0.2.10
FT710_FT8_BIND_PORT=10005
FT710_FT8_URL=/ft8/vnc.html?autoconnect=1&reconnect=1&resize=scale&quality=9&compression=2&path=websockify
FT710_FT8_XSTARTUP=/home/radio/.config/tigervnc/xstartup
FT710_FT8_WORKING_DIRECTORY=/opt/freerig710
FT710_FT8_HOME=/home/radio
FT710_FT8_USER=radio
FT710_FT8_XDG_RUNTIME_DIR=/run/user/1000
FT710_FT8_PULSE_SERVER=unix:/run/user/1000/pulse/native
FT710_FT8_DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
FT710_FT8_WEBSOCKIFY_PIDFILE=/run/user/1000/ft710-websockify.pid
FT710_FT8_WEBSOCKIFY_LOG=/opt/freerig710/api/data/websockify.log
FT710_FT8_START_COMMAND_TIMEOUT=20
FT710_FT8_STARTUP_TIMEOUT=20
FT710_FT8_STOP_TIMEOUT=20
FT710_FT8_SHUTDOWN_TIMEOUT=12

# Normally empty because the browser uses the same public origin as Apache.
FT710_CORS_ORIGINS=
